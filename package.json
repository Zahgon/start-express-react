{
  "type": "module",
  "name": "starter",
  "version": "2026.09.01",
  "main": "server.ts",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .git-hooks || true",
    "biome:check": "biome check --error-on-warnings .",
    "biome:fix": "biome check --write --error-on-warnings .",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build --outDir dist/client",
    "build:server": "vite build --outDir dist/server --ssr src/entry-server",
    "database:migrate": "tsx --env-file=.env scripts/database-migrate",
    "database:reset": "tsx --env-file=.env scripts/database-reset",
    "dev": "tsx watch --include .env --env-file=.env server",
    "install:check": "vitest run tests/install",
    "make:clone": "tsx  --env-file=.env scripts/make-clone",
    "make:purge": "tsx --env-file=.env scripts/make-purge",
    "start": "tsx --env-file=.env server",
    "test": "vitest run --coverage --exclude tests/install",
    "types:check": "tsc --noEmit -p tsconfig.test.json"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/nodemailer": "^8.0.1",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "fs-extra": "^11.4.0",
    "jsdom": "^30.0.1",
    "pluralize": "^8.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/middie": "^9.3.3",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "fastify-plugin": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "zod": "^4.5.4"
  }
}
